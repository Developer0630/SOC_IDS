<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.soc.ui.controller.MainDashboardController">
    <left>
        <VBox prefWidth="224" spacing="14" styleClass="sidebar">
            <padding>
                <Insets top="20" right="14" bottom="16" left="14"/>
            </padding>
            <Label text="SENTINEL NOC" styleClass="brand-title"/>
            <Label text="NETWORK SECURITY" styleClass="brand-subtitle"/>
            <VBox spacing="4" styleClass="navigation">
                <Button text="Dashboard" styleClass="nav-button, nav-button-active" maxWidth="Infinity"/>
                <Button text="Network Monitoring" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="Live Traffic" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="Intrusion Alerts" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="Detection Rules" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="Packet Analysis" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="IP Watchlist" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="Reports &amp; Analytics" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="System Logs" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="Settings" disable="false" styleClass="nav-button" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Modules marked unavailable are not implemented yet."
                   wrapText="true" styleClass="sidebar-note"/>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <VBox spacing="3">
                <Label text="Dashboard" styleClass="page-title"/>
                <Label text="Security monitoring overview" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="databaseStatusLabel" text="DATABASE STARTING" styleClass="status-badge status-neutral"/>
            <Label fx:id="sourceStatusLabel" text="SOURCE  NOT CONNECTED" styleClass="status-badge status-neutral"/>
            <Label fx:id="engineStatusLabel" text="ENGINE  IDLE" styleClass="status-badge status-neutral"/>
            <CheckBox fx:id="darkThemeToggle" text="Dark theme" onAction="#handleThemeChanged"
                      styleClass="theme-toggle"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="18" styleClass="content">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox spacing="12">
                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="PACKETS PROCESSED" styleClass="metric-label"/>
                    <Label fx:id="packetsValue" text="Unavailable" styleClass="metric-value"/>
                    <Label text="Parsed from latest import" styleClass="metric-caption"/>
                </VBox>
                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL ALERTS" styleClass="metric-label"/>
                    <Label fx:id="alertsValue" text="Unavailable" styleClass="metric-value"/>
                    <Label text="Alerts retained this session" styleClass="metric-caption"/>
                </VBox>
                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="CRITICAL ALERTS" styleClass="metric-label"/>
                    <Label fx:id="criticalAlertsValue" text="Unavailable" styleClass="metric-value"/>
                    <Label text="Current session" styleClass="metric-caption"/>
                </VBox>
                <VBox spacing="8" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="TRACKED SOURCE IPS" styleClass="metric-label"/>
                    <Label fx:id="sourceIpsValue" text="Unavailable" styleClass="metric-value"/>
                    <Label text="Latest import · bounded" styleClass="metric-caption"/>
                </VBox>
            </HBox>
            <VBox spacing="8" styleClass="section-panel">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="3">
                        <Label text="Live network monitoring" styleClass="section-title"/>
                        <Label text="Passive capture on one selected interface · payloads are not retained"
                               styleClass="section-description"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="captureStatusLabel" text="CAPTURE IDLE" styleClass="status-badge status-neutral"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ComboBox fx:id="captureInterfaceCombo" promptText="Select network interface"
                              prefWidth="520" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="refreshInterfacesButton" text="Refresh interfaces"
                            onAction="#handleRefreshInterfaces" styleClass="secondary-button"/>
                    <Button fx:id="startCaptureButton" text="Start monitoring"
                            onAction="#handleStartCapture" styleClass="primary-button" disable="true"/>
                    <Button fx:id="stopCaptureButton" text="Stop" onAction="#handleStopCapture"
                            styleClass="secondary-button" disable="true"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="captureMetricsLabel" text="0 packets · 0 B · 0.0 pkt/s · 0 B/s · 0 tracked flow tuples"
                           styleClass="section-description"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="interfaceHelpLabel" text="Interfaces are loading..."
                           styleClass="section-description" wrapText="true"/>
                </HBox>
            </VBox>
            <VBox spacing="10" styleClass="section-panel">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="3">
                        <Label text="Offline PCAP import" styleClass="section-title"/>
                        <Label text="Classic PCAP over Ethernet · maximum 512 MiB and 1,000,000 packets"
                               styleClass="section-description"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="chooseFileButton" text="Select File" onAction="#handleChooseFile"
                            styleClass="primary-button"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="selectedFileLabel" text="No file selected" styleClass="file-name"/>
                        <Label fx:id="importInfoLabel" text="PCAPNG and non-Ethernet captures are not supported."
                               styleClass="section-description"/>
                    </VBox>
                    <Button fx:id="startImportButton" text="Start Import" onAction="#handleStartImport"
                            styleClass="primary-button" disable="true"/>
                    <Button fx:id="cancelImportButton" text="Cancel" onAction="#handleCancelImport"
                            styleClass="secondary-button" disable="true"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Rules / window (seconds):" styleClass="section-description"/>
                    <TextField fx:id="observationWindow" text="10" prefColumnCount="4"
                               promptText="seconds" styleClass="threshold-field"/>
                    <CheckBox fx:id="portScanEnabled" text="Port scan" selected="true"/>
                    <TextField fx:id="portScanThreshold" text="15" prefColumnCount="4"
                               promptText="ports" styleClass="threshold-field"/>
                    <CheckBox fx:id="synEnabled" text="SYN rate" selected="true"/>
                    <TextField fx:id="synThreshold" text="100" prefColumnCount="4"
                               promptText="packets" styleClass="threshold-field"/>
                    <CheckBox fx:id="icmpEnabled" text="ICMP rate" selected="true"/>
                    <TextField fx:id="icmpThreshold" text="100" prefColumnCount="4"
                               promptText="packets" styleClass="threshold-field"/>
                    <Button fx:id="saveRulesButton" text="Save Rules" onAction="#handleSaveRules"
                            styleClass="secondary-button" disable="true"/>
                </HBox>
                <ProgressBar fx:id="importProgressBar" progress="0" maxWidth="Infinity"/>
                <Label fx:id="importStatusLabel" text="Select a classic PCAP file to begin."
                       wrapText="true" styleClass="section-description"/>
            </VBox>
            <TabPane VBox.vgrow="ALWAYS" styleClass="data-tabs">
                <tabs>
                    <Tab text="Recent Alerts" closable="false">
                        <content>
                            <VBox spacing="10" styleClass="section-panel">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3">
                                        <Label text="Detection alerts" styleClass="section-title"/>
                                        <Label text="Heuristic findings include observed metrics and configured thresholds."
                                               styleClass="section-description"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Show Recent" onAction="#handleShowRecentAlerts"
                                            styleClass="secondary-button"/>
                                </HBox>
                                <TableView fx:id="alertTable" VBox.vgrow="ALWAYS" styleClass="data-table"
                                           onMouseClicked="#handleShowAlertDetails">
                                    <placeholder>
                                        <Label text="No alerts found in the selected import or live session."/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="alertTimeColumn" text="Timestamp" prefWidth="190"/>
                                        <TableColumn fx:id="alertSourceColumn" text="Source IP" prefWidth="170"/>
                                        <TableColumn fx:id="alertTypeColumn" text="Detection rule" prefWidth="210"/>
                                        <TableColumn fx:id="severityColumn" text="Severity" prefWidth="130"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Import History" closable="false">
                        <content>
                            <VBox spacing="10" styleClass="section-panel">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3">
                                        <Label text="Persistent PCAP import history" styleClass="section-title"/>
                                        <Label text="Select a completed import to review its stored alerts."
                                               styleClass="section-description"/>
                                    </VBox>
                                </HBox>
                                <TableView fx:id="importHistoryTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                                    <placeholder>
                                        <Label text="No PCAP import history is stored."/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="historyStartedColumn" text="Started" prefWidth="190"/>
                                        <TableColumn fx:id="historyFileColumn" text="File" prefWidth="260"/>
                                        <TableColumn fx:id="historyStatusColumn" text="Status" prefWidth="120"/>
                                        <TableColumn fx:id="historyRecordsColumn" text="Records" prefWidth="110"/>
                                        <TableColumn fx:id="historyAlertsColumn" text="Alerts generated" prefWidth="120"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Traffic Sample" closable="false">
                        <content>
                            <VBox spacing="10" styleClass="section-panel">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3">
                                        <Label text="Parsed packet metadata" styleClass="section-title"/>
                                        <Label text="Most recent 500 supported IPv4/IPv6 Ethernet packet metadata records."
                                               styleClass="section-description"/>
                                    </VBox>
                                </HBox>
                                <TableView fx:id="trafficTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                                    <placeholder>
                                        <Label text="No supported IP packets to display."/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="trafficTimeColumn" text="Timestamp" prefWidth="175"/>
                                        <TableColumn fx:id="trafficSourceColumn" text="Source" prefWidth="150"/>
                                        <TableColumn fx:id="trafficDestinationColumn" text="Destination" prefWidth="150"/>
                                        <TableColumn fx:id="trafficProtocolColumn" text="Protocol" prefWidth="100"/>
                                        <TableColumn fx:id="trafficLengthColumn" text="Length" prefWidth="90"/>
                                        <TableColumn fx:id="trafficFlagsColumn" text="TCP Flags" prefWidth="110"/>
                                        <TableColumn fx:id="trafficDnsColumn" text="DNS query" prefWidth="180"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Observed Endpoints" closable="false">
                        <content>
                            <VBox spacing="10" styleClass="section-panel">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3">
                                        <Label text="Observed network endpoints" styleClass="section-title"/>
                                        <Label text="IP/MAC values are passive observations, not verified device identities."
                                               styleClass="section-description"/>
                                    </VBox>
                                </HBox>
                                <TableView fx:id="endpointTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                                    <placeholder>
                                        <Label text="No endpoints observed in the current capture."/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="endpointIpColumn" text="Observed IP" prefWidth="190"/>
                                        <TableColumn fx:id="endpointMacColumn" text="Observed MAC" prefWidth="190"/>
                                        <TableColumn fx:id="endpointPacketsColumn" text="Packets" prefWidth="120"/>
                                        <TableColumn fx:id="endpointFirstSeenColumn" text="First seen" prefWidth="190"/>
                                        <TableColumn fx:id="endpointLastSeenColumn" text="Last seen" prefWidth="190"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="statusbar">
            <padding>
                <Insets top="8" right="20" bottom="8" left="20"/>
            </padding>
            <Label text="Capture:"/>
            <Label fx:id="captureStatusBarLabel" text="IDLE"/>
            <Label text="|"/>
            <Label text="Processing: idle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Sentinel NOC"/>
        </HBox>
    </bottom>
</BorderPane>
